# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Expo dev server origin (CORS)
FRONTEND_URL=http://localhost:8081

# ─── Database (MySQL) ─────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Aaryan@2821607
DB_NAME=freshora
DB_LOGGING=false

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=freshora_jwt_secret_key_2026_secure_token_123
SESSION_SECRET=freshora_session_secret_xyz
JWT_EXPIRES_IN=7d

# ─── Firebase (server — push notifications, admin SDK) ────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# Firebase client (also set in resources/views — used by Expo app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional: google-services.json / GoogleService-Info.plist paths (after download)
ANDROID_GOOGLE_SERVICES_FILE=./resources/views/signing/google-services.json
IOS_GOOGLE_SERVICES_FILE=./resources/views/signing/GoogleService-Info.plist

# ─── Google Sign-In ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.YOUR_CLIENT_ID

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

EXPO_PUBLIC_RAZORPAY_KEY_ID=
EXPO_PUBLIC_RAZORPAY_CURRENCY=INR

# ─── App / Expo ───────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_NAME=Node Express RN
EXPO_PUBLIC_APP_SLUG=node-express-rn
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_APP_SCHEME=nodeexpressrn
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# ─── Android signing (JKS + key.properties) ───────────────────────────────────
ANDROID_PACKAGE=com.template.nodeexpressrn
ANDROID_KEY_ALIAS=upload
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=
ANDROID_KEY_DNAME=CN=Node Express RN, OU=Mobile, O=Template, L=City, ST=State, C=IN

# ─── iOS ──────────────────────────────────────────────────────────────────────
IOS_BUNDLE_IDENTIFIER=com.template.nodeexpressrn
IOS_SCHEME=NodeExpressRN

# ─── EAS Build (cloud APK / AAB / IPA) ────────────────────────────────────────
EAS_PROJECT_ID=

# ─── Twilio (optional OTP) ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
