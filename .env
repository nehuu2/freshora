# =============================================================================
# MINIMAL SETUP — only DB + password required to run backend + Users example
# Copy: cp .env.example .env
# Everything else is OPTIONAL. Leave blank = feature disabled automatically.
# =============================================================================

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8081

# --- Database (MySQL for Freshora) ---
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Aaryan@2821607
DB_NAME=freshora
DB_LOGGING=false

# --- App / API URL ---
EXPO_PUBLIC_APP_NAME=Freshora
EXPO_PUBLIC_APP_SLUG=freshora
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_APP_SCHEME=freshora
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# =============================================================================
# OPTIONAL INTEGRATIONS — uncomment and fill ONLY what you need
# =============================================================================

# --- Firebase push notifications (optional) ---
# Server admin SDK:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_DATABASE_URL=
# Client (enables expo-notifications plugin when all 3 set):
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Download from Firebase Console, then set paths:
# ANDROID_GOOGLE_SERVICES_FILE=resources/views/signing/google-services.json
# IOS_GOOGLE_SERVICES_FILE=resources/views/signing/GoogleService-Info.plist

# --- Google Sign-In (optional — plugin auto-enables when WEB client id set) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# --- Razorpay payments (optional — server needs both keys, app needs public key) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# EXPO_PUBLIC_RAZORPAY_KEY_ID=
# EXPO_PUBLIC_RAZORPAY_CURRENCY=INR

# --- Auth / sessions ---
JWT_SECRET=freshora_jwt_secret_key_2026_secure_token_123
SESSION_SECRET=freshora_session_secret_xyz
JWT_EXPIRES_IN=7d

# --- Twilio SMS OTP (optional) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# =============================================================================
# MOBILE BUILDS — APK / AAB / IPA (optional until you ship)
# =============================================================================

ANDROID_PACKAGE=com.template.nodeexpressrn
IOS_BUNDLE_IDENTIFIER=com.template.nodeexpressrn
IOS_SCHEME=NodeExpressRN

# Android signing — set password once, then: npm run build:android:apk
ANDROID_KEY_ALIAS=upload
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=
ANDROID_KEY_DNAME=CN=My App, OU=Mobile, O=Company, L=City, ST=State, C=IN

# EAS cloud builds (optional alternative to local Xcode/Gradle)
# EAS_PROJECT_ID=
